generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum OrderStatus {
  PENDING
  PAID
  CANCELLED
  REFUNDED
  CHARGEBACK
}

enum Channel {
  PAYMENTS
  SHOPIFY
  MERCADO_LIVRE
  AMAZON
  SHOPEE
  MANUAL
}

enum InventoryMovementType {
  PURCHASE
  SALE
  RESERVE
  RELEASE
  TRANSFER_IN
  TRANSFER_OUT
  RETURN
  DAMAGE
  ADJUSTMENT
}

enum TrackingEventType {
  PAGE_VIEW
  VIEW_CONTENT
  INITIATE_CHECKOUT
  PAYMENT_CREATED
  PURCHASE
  REFUND
}

enum IntegrationStatus {
  DISCONNECTED
  CONNECTED
  ERROR
}

enum IntegrationMode {
  OAUTH
  DEV_MANUAL
}

enum BillingDocumentType {
  SHIPPING_LABEL
  INVOICE
  INVOICE_PDF
  INVOICE_XML
  REFUNDED_LABEL
  REFUNDED_DANFE
  REFUNDED_XML
}

enum MembershipRole {
  OWNER
  ADMIN
  MEMBER
}

model Tenant {
  id                  String               @id @default(cuid())
  slug                String               @unique
  name                String
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  organization        Organization?
  memberships         Membership[]
  products            Product[]
  variants            ProductVariant[]
  warehouses          Warehouse[]
  balances            InventoryBalance[]
  movements           InventoryMovement[]
  customers           Customer[]
  orders              Order[]
  orderItems          OrderItem[]
  attributions        Attribution[]
  trackingEvents      TrackingEvent[]
  adSpendDaily        AdSpendDaily[]
  expenses            Expense[]
  integrations        Integration[]
  integrationWebhooks IntegrationWebhook[]
  webhookReceipts     WebhookReceipt[]
  webhookEvents       WebhookEvent[]
  auditLogs           AuditLog[]
  returnCases         ReturnCase[]
  dashboardLayout     DashboardLayout?
  pushSubscriptions   PushSubscription[]
  inventoryFolders    InventoryFolder[]
  billingDocuments    BillingDocument[]
}

model PushSubscription {
  id        String   @id @default(cuid())
  tenantId  String
  userId    String
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([userId])
}

model DashboardLayout {
  tenantId  String   @id
  layout    Json
  expanded  Boolean  @default(false)
  updatedAt DateTime @updatedAt
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

model ReturnCase {
  id              String   @id @default(cuid())
  tenantId        String
  channel         Channel
  externalOrderId String
  orderExternalId String?
  claimId         String?
  status          String
  reason          String?
  sku             String?
  quantity        Int      @default(1)
  orderAmount     Decimal? @db.Decimal(12, 2)
  refundAmount    Decimal? @db.Decimal(12, 2)
  sourceUrl       String?
  observedAt      DateTime @default(now())
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  tenant          Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, channel, externalOrderId])
  @@index([tenantId, channel, status])
  @@index([tenantId, channel, orderExternalId])
}

model Organization {
  id        String   @id @default(cuid())
  tenantId  String   @unique
  name      String
  document  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

model User {
  id                String             @id @default(cuid())
  email             String             @unique
  name              String?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  memberships       Membership[]
  pushSubscriptions PushSubscription[]
}

model Membership {
  id        String         @id @default(cuid())
  tenantId  String
  userId    String
  role      MembershipRole @default(MEMBER)
  createdAt DateTime       @default(now())
  tenant    Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([tenantId, userId])
  @@index([userId])
}

model Product {
  id        String           @id @default(cuid())
  tenantId  String
  shopifyId String?
  name      String
  imageUrl  String?
  active    Boolean          @default(true)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  tenant    Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  variants  ProductVariant[]

  @@unique([tenantId, shopifyId])
  @@index([tenantId, active])
}

model ProductVariant {
  id                String              @id @default(cuid())
  tenantId          String
  shopifyId         String?
  productId         String
  sku               String
  name              String
  source            Channel?
  availableQuantity Int?
  fulfillment       String?
  externalUrl       String?
  voltage           String?
  barcode           String?
  salePrice         Decimal             @db.Decimal(12, 2)
  unitCost          Decimal             @db.Decimal(12, 2)
  safetyStock       Int                 @default(0)
  active            Boolean             @default(true)
  manualOverrides   Json?
  inventoryFolderId String?
  tenant            Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  product           Product             @relation(fields: [productId], references: [id], onDelete: Cascade)
  orderItems        OrderItem[]
  movements         InventoryMovement[]
  balances          InventoryBalance[]
  inventoryFolder   InventoryFolder?     @relation(fields: [inventoryFolderId], references: [id], onDelete: SetNull)

  @@unique([tenantId, sku])
  @@unique([tenantId, shopifyId])
  @@index([tenantId, productId])
  @@index([tenantId, inventoryFolderId])
}

model InventoryFolder {
  id        String           @id @default(cuid())
  tenantId  String
  name      String
  trackingStartDate DateTime?
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  tenant    Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  variants  ProductVariant[]

  @@unique([tenantId, name])
  @@index([tenantId])
}

model Warehouse {
  id        String              @id @default(cuid())
  tenantId  String
  code      String
  name      String
  channel   Channel?
  active    Boolean             @default(true)
  tenant    Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  balances  InventoryBalance[]
  movements InventoryMovement[]

  @@unique([tenantId, code])
  @@index([tenantId, active])
}

model InventoryBalance {
  id          String         @id @default(cuid())
  tenantId    String
  variantId   String
  warehouseId String
  onHand      Int            @default(0)
  reserved    Int            @default(0)
  updatedAt   DateTime       @updatedAt
  tenant      Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  variant     ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  warehouse   Warehouse      @relation(fields: [warehouseId], references: [id], onDelete: Cascade)

  @@unique([tenantId, variantId, warehouseId])
  @@index([tenantId, warehouseId])
}

model InventoryMovement {
  id             String                @id @default(cuid())
  tenantId       String
  variantId      String
  warehouseId    String
  type           InventoryMovementType
  quantity       Int
  reference      String?
  orderId        String?
  note           String?
  idempotencyKey String?
  source         String                @default("SYNC")
  metadata       Json?
  createdAt      DateTime              @default(now())
  tenant         Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  variant        ProductVariant        @relation(fields: [variantId], references: [id])
  warehouse      Warehouse             @relation(fields: [warehouseId], references: [id])
  order          Order?                @relation(fields: [orderId], references: [id])

  @@unique([tenantId, idempotencyKey])
  @@index([tenantId, variantId, warehouseId, createdAt])
  @@index([tenantId, orderId])
}

model Customer {
  id              String   @id @default(cuid())
  tenantId        String
  sourceKey       String?
  externalId      String?
  emailHash       String?
  phoneHash       String?
  name            String?
  city            String?
  state           String?
  zip             String?
  manualOverrides Json?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  tenant          Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  orders          Order[]

  @@unique([tenantId, sourceKey])
  @@index([tenantId, externalId])
  @@index([tenantId, emailHash])
}

model Order {
  id              String              @id @default(cuid())
  tenantId        String
  externalId      String
  channel         Channel
  status          OrderStatus         @default(PENDING)
  customerId      String?
  currency        String              @default("BRL")
  grossAmount     Decimal             @db.Decimal(12, 2)
  discountAmount  Decimal             @default(0) @db.Decimal(12, 2)
  shippingAmount  Decimal             @default(0) @db.Decimal(12, 2)
  feeAmount       Decimal             @default(0) @db.Decimal(12, 2)
  taxAmount       Decimal             @default(0) @db.Decimal(12, 2)
  netRevenue      Decimal?            @db.Decimal(12, 2)
  paymentMethod   String?
  manualOverrides Json?
  sourceSnapshot  Json?
  paidAt          DateTime?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  tenant          Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer        Customer?           @relation(fields: [customerId], references: [id])
  items           OrderItem[]
  attribution     Attribution?
  movements       InventoryMovement[]
  trackingEvents  TrackingEvent[]
  billingDocuments BillingDocument[]

  @@unique([tenantId, channel, externalId])
  @@index([tenantId, status, paidAt])
  @@index([tenantId, channel, createdAt])
}

model BillingDocument {
  id        String              @id @default(cuid())
  tenantId  String
  orderId   String
  type      BillingDocumentType
  fileName  String
  mimeType  String
  size      Int
  data      Bytes
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt
  tenant    Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  order     Order               @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@unique([tenantId, orderId, type])
  @@index([tenantId, createdAt])
  @@index([tenantId, type])
}

model OrderItem {
  id              String          @id @default(cuid())
  tenantId        String
  orderId         String
  variantId       String?
  sku             String
  name            String
  quantity        Int
  unitPrice       Decimal         @db.Decimal(12, 2)
  unitCost        Decimal         @db.Decimal(12, 2)
  manualOverrides Json?
  tenant          Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  order           Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variant         ProductVariant? @relation(fields: [variantId], references: [id])

  @@index([tenantId, orderId])
  @@index([tenantId, sku])
}

model AuditLog {
  id         String   @id @default(cuid())
  tenantId   String
  entityType String
  entityId   String
  action     String
  source     String   @default("MANUAL")
  before     Json?
  after      Json?
  metadata   Json?
  createdAt  DateTime @default(now())
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, entityType, entityId, createdAt])
  @@index([tenantId, action, createdAt])
}

model Attribution {
  id          String  @id @default(cuid())
  tenantId    String
  orderId     String  @unique
  sessionId   String?
  visitorId   String?
  source      String?
  medium      String?
  campaign    String?
  content     String?
  term        String?
  fbclid      String?
  fbp         String?
  fbc         String?
  gclid       String?
  campaignId  String?
  adsetId     String?
  adId        String?
  landingPage String?
  referrer    String?
  firstTouch  Json?
  lastTouch   Json?
  tenant      Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  order       Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([tenantId, campaignId])
  @@index([tenantId, adId])
  @@index([tenantId, source, medium])
}

model TrackingEvent {
  id          String            @id @default(cuid())
  tenantId    String
  eventId     String
  type        TrackingEventType
  occurredAt  DateTime
  visitorId   String?
  sessionId   String?
  orderId     String?
  url         String?
  referrer    String?
  utmSource   String?
  utmMedium   String?
  utmCampaign String?
  utmContent  String?
  utmTerm     String?
  fbclid      String?
  fbp         String?
  fbc         String?
  gclid       String?
  campaignId  String?
  adsetId     String?
  adId        String?
  value       Decimal?          @db.Decimal(12, 2)
  currency    String?
  metadata    Json?
  tenant      Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  order       Order?            @relation(fields: [orderId], references: [id])

  @@unique([tenantId, eventId])
  @@index([tenantId, occurredAt])
  @@index([tenantId, sessionId, occurredAt])
  @@index([tenantId, visitorId, occurredAt])
}

model AdSpendDaily {
  id           String   @id @default(cuid())
  tenantId     String
  platform     String
  date         DateTime @db.Date
  accountId    String
  campaignId   String
  campaignName String
  adsetId      String?
  adsetName    String?
  adId         String?
  adName       String?
  spend        Decimal  @db.Decimal(12, 2)
  impressions  Int      @default(0)
  clicks       Int      @default(0)
  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, platform, date, accountId, campaignId, adsetId, adId])
  @@index([tenantId, date, platform])
  @@index([tenantId, campaignId, date])
}

model Expense {
  id          String   @id @default(cuid())
  tenantId    String
  date        DateTime
  category    String
  description String
  amount      Decimal  @db.Decimal(12, 2)
  kind        String   @default("FIXED")
  isFixed     Boolean  @default(false)
  installments Int     @default(1)
  rate        Decimal? @db.Decimal(7, 4)
  schedule    String   @default("CUSTOM")
  channel     Channel?
  orderId     String?
  createdAt   DateTime @default(now())
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, date, category])
}

model Integration {
  id                     String               @id @default(cuid())
  tenantId               String
  provider               String
  mode                   IntegrationMode      @default(DEV_MANUAL)
  status                 IntegrationStatus    @default(DISCONNECTED)
  externalAccountId      String?
  shopDomain             String?
  accessTokenEncrypted   String?
  refreshTokenEncrypted  String?
  scopes                 String?
  webhookSecretEncrypted String?
  lastSyncAt             DateTime?
  lastError              String?
  connectedAt            DateTime?
  disconnectedAt         DateTime?
  config                 Json?
  metadata               Json?
  createdAt              DateTime             @default(now())
  updatedAt              DateTime             @updatedAt
  tenant                 Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  webhooks               IntegrationWebhook[]

  @@unique([tenantId, provider])
  @@index([tenantId, status])
  @@index([provider, shopDomain])
}

model IntegrationWebhook {
  id                String      @id @default(cuid())
  tenantId          String
  integrationId     String
  provider          String
  topic             String
  callbackUrl       String
  externalWebhookId String?
  status            String      @default("PENDING")
  lastRegisteredAt  DateTime?
  lastError         String?
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt
  tenant            Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  integration       Integration @relation(fields: [integrationId], references: [id], onDelete: Cascade)

  @@unique([integrationId, topic])
  @@index([tenantId, provider, status])
}

model WebhookReceipt {
  id          String    @id @default(cuid())
  tenantId    String
  provider    String
  eventId     String
  eventType   String?
  payloadHash String
  processedAt DateTime?
  error       String?
  createdAt   DateTime  @default(now())
  tenant      Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, provider, eventId])
}

model WebhookEvent {
  id            String    @id @default(cuid())
  tenantId      String
  integrationId String?
  provider      String
  eventId       String
  topic         String
  shopDomain    String?
  status        String
  payload       Json?
  error         String?
  receivedAt    DateTime  @default(now())
  processedAt   DateTime?
  tenant        Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, provider, eventId])
  @@index([tenantId, provider, topic, receivedAt])
}
